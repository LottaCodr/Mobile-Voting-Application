# Flutter receives only the two public values below.
# Never put SUPABASE_SERVICE_ROLE_KEY in Flutter, browser builds, Git, or CI logs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional. Register this exact URL in Supabase Auth > URL Configuration.
PASSWORD_RESET_REDIRECT=io.civicvote.app://reset-callback/

# Edge Function / scheduler secrets. Set these with `supabase secrets set`,
# never through a client-side Dart define.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=CivicVote <notices@example.org>
