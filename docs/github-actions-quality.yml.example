name: Quality

on:
  push:
    branches: [main, arena/**]
  pull_request:

permissions:
  contents: read

jobs:
  app:
    name: Expo app typecheck, lint and export
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          # Expo SDK 57 / React Native 0.86 require Node 22.13 or newer.
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npm run typecheck
      - run: npm run lint
      - name: Verify the app bundles for every platform
        run: npx expo export --platform all
      - name: Expo dependency and config checks
        run: npx expo-doctor

  supabase:
    name: Supabase migration smoke test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: supabase/setup-cli@v1
        with:
          version: latest
      - name: Start local Supabase
        run: supabase start
      - name: Apply schema and seed data
        run: supabase db reset
      - name: Stop local Supabase
        if: always()
        run: supabase stop --no-backup

  secrets:
    name: Secret scan
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
